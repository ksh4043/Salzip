# 이 파일을 복사해 .env를 만들고 값을 채운다. (.env는 커밋하지 않는다)
#   cp .env.example .env
# 실제 키 값은 이 파일에 쓰지 않는다.

# ── LLM ─────────────────────────────────────────────
# 에이전트는 OpenAI GPT를 쓴다.
OPENAI_API_KEY=
# 사용할 모델 ID (OpenAI 문서에서 확인해 채운다)
LLM_MODEL=

# ── 공공데이터포털: 국토교통부 실거래가 API (담당 B) ──
# 공공데이터포털(data.go.kr)에서 발급받은 일반 인증키(Decoding)
# 인증키는 계정마다 하나라서 아래 API를 모두 이 키 하나로 부른다. (API마다 다른 건 엔드포인트뿐)
#   - 아파트 매매 실거래가 상세 자료
#   - 아파트 전월세 실거래가 자료
#   - 연립다세대 매매 실거래가 자료
#   - 연립다세대 전월세 실거래가 자료
#   - 오피스텔 전월세 실거래가 자료
#   - TODO(확인 필요): 오피스텔 매매 실거래가 자료 (전세가율 계산에 필요, 활용신청 추가 필요)
# 엔드포인트 주소는 비밀 값이 아니므로 여기 두지 않는다. (AGENTS.md 2장 실거래가 API 표 참고)
MOLIT_API_KEY=

# ── 온통청년 청년정책 API (담당 D) ───────────────────
# 온통청년(youthcenter.go.kr) Open API 인증키
YOUTHCENTER_API_KEY=

# ── 에이전트 설정 (담당 A) ────────────────────────────
# 에이전트 루프 최대 반복 횟수
AGENT_MAX_STEPS=10
